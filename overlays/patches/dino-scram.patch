+            module.received_nonza(stream, node);
+        }
+        fail_if_not(flag.finished);
+        fail_if_not_eq_str(flag.password, null);
+    }
+
+    private void invalid_challenge(bool sasl2) {
+        var stream = new SaslTestStream();
+        var flag = scram_flag();
+        stream.add_flag(flag);
