+    private static uint8[] hmac(ChecksumType type, uint8[] key, uint8[] data) {
+        Hmac mac = new Hmac(type, key);
+        mac.update(data);
+        size_t size = (size_t) type.get_length();
+        uint8[] res = new uint8[size];
+        mac.get_digest(res, ref size);
+        return res;
+    }
