+    public static Flag? start_scram(XmppStream stream, string[] supported_mechanisms, string name, string password, bool require_announcement, out string client_first_message, ChannelBindingProvider? binding_provider = null) throws SaslError {
+        client_first_message = "";
+        bool server_offers_scram = false;
+        bool server_offers_plus = false;
+        foreach (string mechanism in supported_mechanisms) {
+            if (Mechanism.is_scram(mechanism)) server_offers_scram = true;
+            if (Mechanism.is_plus(mechanism)) server_offers_plus = true;
+        }
+        // Servers without SCRAM (e.g. PLAIN-only LDAP setups) may still announce XEP-0440, there is nothing to bind then.
+        if (!server_offers_scram) return null;
+        StanzaNode? binding_node = stream.features.get_subnode("sasl-channel-binding", CHANNEL_BINDING_NS_URI);
+        // Only relax the checks for SASL1 servers without XEP-0440, so an announcement is always enforced.
+        bool strict_binding = require_announcement || binding_node != null;
+        if (strict_binding && server_offers_plus != (binding_node != null)) {
+            throw new SaslError.CHANNEL_BINDING("Incomplete channel-binding announcement");
+        }
+
+        uint8[]? channel_binding_data = null;
+        string? binding_type = null;
+        foreach (string candidate in new string[] { "tls-exporter", "tls-unique", "tls-server-end-point" }) {
+            if (binding_node == null) break;
+            foreach (StanzaNode type_node in binding_node.get_subnodes("channel-binding", CHANNEL_BINDING_NS_URI)) {
+                if (type_node.get_attribute("type") != candidate) continue;
+                channel_binding_data = get_channel_binding_data(stream, candidate == "tls-exporter" ? TlsChannelBindingType.EXPORTER : candidate == "tls-unique" ? TlsChannelBindingType.UNIQUE : TlsChannelBindingType.SERVER_END_POINT, binding_provider);
+                if (channel_binding_data != null) {
+                    binding_type = candidate;
+                    break;
+                }
+            }
+            if (binding_type != null) break;
+        }
+        if (binding_node == null) {
+            // Use the RFC 9266 default, trying tls-unique first because TLS 1.3 connections refuse it.
+            foreach (string candidate in new string[] { "tls-unique", "tls-exporter" }) {
+                channel_binding_data = get_channel_binding_data(stream, candidate == "tls-unique" ? TlsChannelBindingType.UNIQUE : TlsChannelBindingType.EXPORTER, binding_provider);
+                if (channel_binding_data != null) {
+                    binding_type = candidate;
+                    break;
+                }
+            }
+        }
+        if (strict_binding && server_offers_plus && channel_binding_data == null) {
+            throw new SaslError.CHANNEL_BINDING("No usable channel-binding type");
+        }
+
+        string? mechanism = Mechanism.select_scram(supported_mechanisms, channel_binding_data != null);
+        if (strict_binding && server_offers_plus && (mechanism == null || !Mechanism.is_plus(mechanism))) {
+            throw new SaslError.CHANNEL_BINDING("No supported channel-binding mechanism");
+        }
+        if (mechanism == null) return null;
+
+        string gs2_header = "n,,";
+        if (Mechanism.is_plus(mechanism)) {
+            gs2_header = @"p=$(binding_type),,";
+        } else if (!server_offers_plus && (get_channel_binding_data(stream, TlsChannelBindingType.EXPORTER, binding_provider) != null ||
+                   get_channel_binding_data(stream, TlsChannelBindingType.UNIQUE, binding_provider) != null ||
+                   get_channel_binding_data(stream, TlsChannelBindingType.SERVER_END_POINT, binding_provider) != null)) {
+            gs2_header = "y,,";
+        }
+
+        uint8[] channel_binding = gs2_header.data;
+        if (Mechanism.is_plus(mechanism)) {
+            foreach (uint8 b in channel_binding_data) channel_binding += b;
+        }
+
+        uint8[] nonce = new uint8[24];
+        FileStream? random = FileStream.open("/dev/urandom", "rb");
+        if (random == null || random.read(nonce) != nonce.length) throw new SaslError.RANDOM("Cannot read /dev/urandom");
+        string client_nonce = Base64.encode(nonce);
+        string sasl_name = name.replace("=", "=3D").replace(",", "=2C");
+        client_first_message = @"$(gs2_header)n=$sasl_name,r=$client_nonce";
