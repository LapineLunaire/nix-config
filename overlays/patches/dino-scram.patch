+    private static uint8[] xor(uint8[] a1, uint8[] a2) {
+        uint8[] mix = new uint8[a1.length];
+        for(int i = 0; i < a1.length; i++) {
+            mix[i] = a1[i] ^ a2[i];
+        }
+        return mix;
+    }
 }
