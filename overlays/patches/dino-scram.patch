+        if (announced != null) {
+            var binding = new StanzaNode.build("sasl-channel-binding", "urn:xmpp:sasl-cb:0");
+            foreach (string type in announced) {
+                binding.put_node(new StanzaNode.build("channel-binding", "urn:xmpp:sasl-cb:0").put_attribute("type", type));
+            }
+            stream.features.put_node(binding);
+        }
+        try {
+            string first;
+            var flag = start_scram(stream, { "SCRAM-SHA-256-PLUS", "SCRAM-SHA-256" }, "user", "password", require_announcement, out first, binding_provider(available));
