+        var flag = new Flag();
+        flag.mechanism = mechanism;
+        flag.name = sasl_name;
+        flag.password = password.normalize(-1, NormalizeMode.NFKC);
+        flag.client_nonce = client_nonce;
+        flag.channel_binding = channel_binding;
+        return flag;
+    }
