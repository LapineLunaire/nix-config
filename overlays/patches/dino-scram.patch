+    // Provides the binding type name as binding data for each of the available types
+    private ChannelBindingProvider binding_provider(string[] available) {
+        return (type) => {
+            string name = type == TlsChannelBindingType.EXPORTER ? "tls-exporter" : type == TlsChannelBindingType.UNIQUE ? "tls-unique" : "tls-server-end-point";
+            return name in available ? name.data : null;
+        };
+    }
